{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        }, 
        {
            "name": "pytest: test_live_priority",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-s","-m", "live", "tests/test_priority.py::test_live_accuracy"],
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }, 
        {
            "name": "pytest: test_live_digests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-s","-m", "live", "tests/test_daily_digest.py"],
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}